rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is faculty or admin
    function isFaculty() {
      return (
        request.auth != null && (
          request.auth.token.email == 'bobzkie181992@gmail.com' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'faculty')
        )
      );
    }

    // Allow read and write for user profiles and results
    match /users/{userId} {
      allow read, write: if true;
      
      // Allow users to manage their own subcollections (like results)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Allow everyone to read and update curriculum
    match /curriculum/{topicId} {
      allow read, write: if true;
    }

    // Collaborative study requests between students
    match /study_requests/{requestId} {
      allow read, write: if true;
    }

    // Direct chat messages between students
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Video lectures published by faculty
    match /videoLectures/{lectureId} {
      allow read, write: if true;
    }

    // Learning presentations published by faculty
    match /presentations/{presentationId} {
      allow read, write: if true;
    }

    // Presentation views and engagement records
    match /presentation_views/{viewId} {
      allow read, write: if true;
    }

    // Oral recitation plus points awarded to students by faculty
    match /oral_recitations/{recitationId} {
      allow read, write: if true;
    }

    // Teacher progress, diagnostic, remediation, and section evaluation reports
    match /teacher_reports/{reportId} {
      allow read, write: if true;
    }

    // Summative Assessment Transcripts and outcome evaluations
    match /summative_transcripts/{transcriptId} {
      allow read, write: if true;
    }

    // Diagnostic question item pool
    match /diagnostic_questions/{questionId} {
      allow read, write: if true;
    }

    // Global configurations and settings
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // Academic quarters or terms managed by faculty
    match /academic_terms/{termId} {
      allow read, write: if true;
    }
  }
}
